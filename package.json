{
  "name": "nuxthub-starter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler deploy --env preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@iconify/json": "^2.2.491",
    "@libsql/client": "^0.17.4",
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "^0.10.12",
    "@nuxtjs/color-mode": "4.1.0",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@unocss/extractor-mdc": "~66.7.2",
    "@unocss/nuxt": "~66.7.2",
    "@unocss/preset-icons": "~66.7.2",
    "@vue/devtools-api": "^8.2.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "motion-v": "^1.9.0",
    "nuxt": "~4.6.4",
    "nuxt-og-image": "7.0.7",
    "nuxt-schema-org": "7.0.1",
    "nuxt-seo-utils": "9.0.1",
    "ogl": "^1.0.11",
    "pinia": "4.1.0",
    "satori": "^0.47.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@vitest/ui": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.2",
    "gray-matter": "^4.0.3",
    "happy-dom": "^20.14.6",
    "unocss": "~66.7.2",
    "unocss-preset-theme": "^0.14.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.160.0"
  },
  "resolutions": {},
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "unrs-resolver",
      "vue-demi",
      "workerd"
    ]
  }
}