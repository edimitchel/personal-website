# Translation Configuration
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Translator and reviewer names for metadata
TRANSLATOR_NAME=AI Assistant
REVIEWER_NAME=Your Name

# Local development — copy .dev.vars.example to .dev.vars for wrangler dev
# Production/preview secrets — set via Cloudflare Workers dashboard or `wrangler secret put`
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, STUDIO_GITHUB_CLIENT_ID, STUDIO_GITHUB_CLIENT_SECRET
# Admin publish (server only, never commit a real token). Empty keeps drafts local.
# NUXT_GITHUB_TOKEN=
# NUXT_GITHUB_BRANCH=content/admin
# Translation (server only). Provider: xai, mistral, or local. Empty key keeps the button local.
# NUXT_TRANSLATION_PROVIDER=xai
# NUXT_TRANSLATION_API_KEY=
# NUXT_TRANSLATION_BASE_URL=
# NUXT_TRANSLATION_MODEL=

# OG images (required in production — set via Cloudflare Workers secrets in prod)
NUXT_OG_IMAGE_SECRET=your_og_image_secret_here

# Prerender — set to true in CI to fail the build on prerender errors
# NUXT_PRERENDER_FAIL_ON_ERROR=true

# Incremental prerender — set to false to force a full prerender
# INCREMENTAL_PRERENDER=false

# GitHub Actions (environment: Cloudflare)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here